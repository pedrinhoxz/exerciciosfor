using System;

class Program
{
    static void Main()
    {
        int total = 0;

        for (int dia = 1; dia <= 6; dia++)
        {
            Console.Write($"Digite a quantidade de peças do dia {dia}: ");
            int pecas = int.Parse(Console.ReadLine());

            total += pecas;
        }

        Console.WriteLine($"Total de peças produzidas na semana: {total}");
    }
}
