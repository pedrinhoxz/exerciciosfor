using System;

class Program
{
    static void Main()
    {
        for (int i = 1; i <= 5; i++)
        {
            Console.Write($"Digite a força de ruptura da amostra {i} (N): ");
            double forca = double.Parse(Console.ReadLine());

            if (forca < 15.0)
            {
                Console.WriteLine("Fio Fraco");
            }
            else
            {
                Console.WriteLine("Fio Conforme");
            }
        }
    }
}
